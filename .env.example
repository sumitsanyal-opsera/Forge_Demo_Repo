# =============================================================================
# Opsera Stuck Pipeline Detection — Environment Variables
# Copy this file to .env and fill in your values. NEVER commit .env to git.
# =============================================================================

# --- Database ---
# PostgreSQL connection string. connection_limit sets the PrismaClient pool size.
DATABASE_URL=postgresql://postgres:password@localhost:5432/opsera_stuck_pipeline?connection_limit=20&connect_timeout=10

# --- Redis ---
# Redis connection URL for caching and Streams message broker.
REDIS_URL=redis://localhost:6379

# --- Application ---
# Runtime environment: development | test | production
NODE_ENV=development

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# --- Salesforce OAuth ---
# Salesforce Connected App credentials (never commit real values)
SALESFORCE_CLIENT_ID=your_consumer_key_here
SALESFORCE_CLIENT_SECRET=your_consumer_secret_here
SALESFORCE_REDIRECT_URI=https://your-app.example.com/api/v1/orgs/oauth/callback

# --- Email (SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=your_smtp_password_here
SMTP_FROM=Opsera Alerts <noreply@example.com>

# --- Security ---
# AES-256 key for encrypting refresh tokens at rest (32-byte hex string)
TOKEN_ENCRYPTION_KEY=change_this_to_a_random_64_hex_char_string_before_use

# --- Service Ports ---
API_GATEWAY_PORT=3000
BASELINE_SERVICE_PORT=3001
DETECTION_SERVICE_PORT=3002
ALERT_SERVICE_PORT=3003
DASHBOARD_SERVICE_PORT=3004

# --- Salesforce DX ---

# Salesforce DX CLI state and temp files
.sfdx/
.sf/

# Scratch org authentication files (NEVER commit these — contain credentials)
**/config/scratch-org-auth.json
**/config/dev-hub-auth.json
authfile.json

# Deployment manifest snapshots (auto-generated)
**/package.xml.bak

# --- Node.js ---

# Dependencies
node_modules/

# Coverage reports
coverage/
.nyc_output/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS files
.DS_Store
Thumbs.db
.AppleDouble
.LSOverride

# Editor directories and files
.idea/
.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- LWC Jest ---
jest-results/

# --- Salesforce Org artifacts ---

# Compiled Apex (not source of truth)
force-app/**/*.cls-meta.xml.bak

# Destructive changes manifests (should be reviewed before committing)
destructiveChanges/
destructiveChangesPre/
destructiveChangesPost/

# --- CI/CD ---

# Local environment variables (never commit secrets)
.env
.env.local
.env.*.local

# Pipeline auth files
.ci-auth/

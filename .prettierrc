{
    "trailingComma": "es5",
    "tabWidth": 4,
    "singleQuote": true,
    "printWidth": 120,
    "bracketSpacing": true,
    "arrowParens": "avoid",
    "endOfLine": "lf",
    "overrides": [
        {
            "files": "*.{cls,trigger,soql}",
            "options": {
                "tabWidth": 4,
                "printWidth": 120,
                "plugins": ["prettier-plugin-apex"],
                "parser": "apex"
            }
        },
        {
            "files": "*.{xml,html}",
            "options": {
                "tabWidth": 4,
                "printWidth": 120,
                "parser": "html",
                "htmlWhitespaceSensitivity": "ignore"
            }
        },
        {
            "files": "*.json",
            "options": {
                "tabWidth": 4,
                "parser": "json"
            }
        },
        {
            "files": "*.{js,ts}",
            "options": {
                "tabWidth": 4,
                "singleQuote": true,
                "printWidth": 120
            }
        }
    ]
}

<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:metadata.tooling.soap.sforce.com"
           xmlns="urn:metadata.tooling.soap.sforce.com"
           elementFormDefault="qualified">

  <xs:element name="CustomObject">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="fullName" type="xs:string"/>
        <xs:element name="label" type="xs:string"/>
        <xs:element name="deploymentStatus" type="DeploymentStatus"/>
        <xs:element name="sharingModel" type="SharingModel" minOccurs="0"/>
        <xs:element name="nameField" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="type" type="xs:string"/>
              <xs:element name="label" type="xs:string"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:simpleType name="DeploymentStatus">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Deployed"/>
      <xs:enumeration value="InDevelopment"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="SharingModel">
    <xs:restriction base="xs:string">
      <xs:enumeration value="ReadWrite"/>
      <xs:enumeration value="Read"/>
      <xs:enumeration value="Private"/>
    </xs:restriction>
  </xs:simpleType>

</xs:schema>

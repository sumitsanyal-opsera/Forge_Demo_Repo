<?xml version="1.0" encoding="UTF-8"?>
<ConnectedApp xmlns="http://soap.sforce.com/2006/04/metadata">
    <contactEmail>devops-placeholder@example.com</contactEmail>
    <label>Smoke Test CI/CD Integration</label>

    <!--
        IMPORTANT: The consumer key (client_id / iss claim) is AUTO-GENERATED by Salesforce
        when this metadata is deployed. It cannot be set here.
        After deployment, retrieve it from: Setup > App Manager > Smoke Test CI/CD Integration > View.
        Store the consumer key as a secret in your CI/CD platform (see docs/connected-app-setup.md).
    -->
    <oauthConfig>
        <callbackUrl>https://login.salesforce.com/services/oauth2/callback</callbackUrl>

        <!--
            CERTIFICATE PLACEHOLDER: The certificate referenced here ('SmokeTestCICDCert')
            must be generated separately and uploaded to the org BEFORE or AFTER deployment:
              - Generate a self-signed X.509 certificate using OpenSSL (see docs/connected-app-setup.md).
              - Upload the public certificate via: Setup > Certificate and Key Management > Import from Keystore
                OR Setup > App Manager > [This App] > Edit > Use Digital Signatures.
              - The private key MUST remain in CI/CD platform secret management — never commit it here.
              - If deploying to a scratch org, upload the certificate after org creation and update
                this value in App Manager to match the uploaded certificate's API name.
        -->
        <certificate>SmokeTestCICDCert</certificate>

        <isAdminApproved>true</isAdminApproved>
        <isConsumerSecretOptional>false</isConsumerSecretOptional>
        <isIntrospectAllToken>false</isIntrospectAllToken>
        <isSecretRequiredForRefreshToken>true</isSecretRequiredForRefreshToken>

        <!--
            Minimum required OAuth scopes: api (execute REST calls) + refresh_token (token renewal).
            No additional scopes granted — principle of least privilege.
        -->
        <scopes>Api</scopes>
        <scopes>RefreshToken</scopes>
    </oauthConfig>

    <oauthPolicy>
        <!--
            IP RESTRICTIONS: Set to EnforceIpRestrictions for production.
            For development/scratch org environments, change to RelaxIpRestrictions.
            To configure allowed IP ranges: Setup > App Manager > [This App] > Edit > IP Relaxation
            and add the CIDR ranges published by your CI/CD platform (see docs/connected-app-setup.md
            for GitHub Actions, Jenkins, GitLab CI, and Azure DevOps IP ranges).
        -->
        <ipRelaxation>EnforceIpRestrictions</ipRelaxation>

        <!--
            Only users pre-authorized via assigned permission set may use this Connected App.
            Users must have SmokeTest_API_User or SmokeTest_Admin assigned (see permissionSetName below).
        -->
        <permittedUsers>AdminApprovedUsersArePreAuthorized</permittedUsers>
    </oauthPolicy>

    <!--
        Pre-authorized permission sets: users holding either of these permission sets
        are allowed to authenticate via this Connected App without per-user admin approval.
        Assign SmokeTest_API_User to the CI/CD service account user.
        Assign SmokeTest_Admin only to human admins who need full access.
    -->
    <permissionSetName>SmokeTest_API_User</permissionSetName>
    <permissionSetName>SmokeTest_Admin</permissionSetName>
</ConnectedApp>

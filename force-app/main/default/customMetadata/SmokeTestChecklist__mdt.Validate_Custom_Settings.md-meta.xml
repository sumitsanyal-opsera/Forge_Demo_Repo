<?xml version="1.0" encoding="UTF-8"?>
<CustomMetadata xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <label>Validate Custom Settings</label>
    <protected>false</protected>
    <values>
        <field>IsEnabled__c</field>
        <value xsi:type="xsd:boolean">true</value>
    </values>
    <values>
        <field>CheckType__c</field>
        <value xsi:type="xsd:string">SOQLValidation</value>
    </values>
    <values>
        <field>Query__c</field>
        <value xsi:type="xsd:string">SELECT Id, Name, SetupOwnerId FROM SmokeTestCustomConfig__c WHERE SetupOwnerId = :orgId</value>
    </values>
    <values>
        <field>ExpectedResult__c</field>
        <value xsi:type="xsd:string">Required custom setting default org values are configured</value>
    </values>
    <values>
        <field>FailureMessage__c</field>
        <value xsi:type="xsd:string">Custom setting default org values are missing or incorrect. Verify custom setting configuration post-deployment.</value>
    </values>
    <values>
        <field>ExecutionOrder__c</field>
        <value xsi:type="xsd:double">4</value>
    </values>
    <values>
        <field>Severity__c</field>
        <value xsi:type="xsd:string">Warning</value>
    </values>
</CustomMetadata>

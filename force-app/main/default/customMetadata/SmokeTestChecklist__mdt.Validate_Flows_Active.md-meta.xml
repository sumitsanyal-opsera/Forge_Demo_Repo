<?xml version="1.0" encoding="UTF-8"?>
<CustomMetadata xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <label>Validate Flows Active</label>
    <protected>false</protected>
    <values>
        <field>IsEnabled__c</field>
        <value xsi:type="xsd:boolean">true</value>
    </values>
    <values>
        <field>CheckType__c</field>
        <value xsi:type="xsd:string">MetadataQuery</value>
    </values>
    <values>
        <field>Query__c</field>
        <value xsi:type="xsd:string">SELECT Id, ActiveVersion.VersionNumber FROM FlowDefinition WHERE DeveloperName = :flowName</value>
    </values>
    <values>
        <field>ExpectedResult__c</field>
        <value xsi:type="xsd:string">Active version found for all registered Flows</value>
    </values>
    <values>
        <field>FailureMessage__c</field>
        <value xsi:type="xsd:string">One or more Flows are not activated post-deployment. Review flow activation status in Setup.</value>
    </values>
    <values>
        <field>ExecutionOrder__c</field>
        <value xsi:type="xsd:double">1</value>
    </values>
    <values>
        <field>Severity__c</field>
        <value xsi:type="xsd:string">Critical</value>
    </values>
</CustomMetadata>

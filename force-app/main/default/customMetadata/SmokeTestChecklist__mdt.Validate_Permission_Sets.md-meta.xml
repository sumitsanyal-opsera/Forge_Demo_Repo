<?xml version="1.0" encoding="UTF-8"?>
<CustomMetadata xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <label>Validate Permission Sets</label>
    <protected>false</protected>
    <values>
        <field>IsEnabled__c</field>
        <value xsi:type="xsd:boolean">true</value>
    </values>
    <values>
        <field>CheckType__c</field>
        <value xsi:type="xsd:string">SOQLValidation</value>
    </values>
    <values>
        <field>Query__c</field>
        <value xsi:type="xsd:string">SELECT Id, Name FROM PermissionSet WHERE Name IN :expectedPermSetNames AND IsCustom = true</value>
    </values>
    <values>
        <field>ExpectedResult__c</field>
        <value xsi:type="xsd:string">All required custom permission sets exist in the org</value>
    </values>
    <values>
        <field>FailureMessage__c</field>
        <value xsi:type="xsd:string">One or more expected permission sets are missing. Verify permission set deployment completed successfully.</value>
    </values>
    <values>
        <field>ExecutionOrder__c</field>
        <value xsi:type="xsd:double">2</value>
    </values>
    <values>
        <field>Severity__c</field>
        <value xsi:type="xsd:string">Critical</value>
    </values>
</CustomMetadata>

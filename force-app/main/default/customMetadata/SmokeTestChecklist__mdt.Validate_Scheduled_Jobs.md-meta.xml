<?xml version="1.0" encoding="UTF-8"?>
<CustomMetadata xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <label>Validate Scheduled Jobs</label>
    <protected>false</protected>
    <values>
        <field>IsEnabled__c</field>
        <value xsi:type="xsd:boolean">true</value>
    </values>
    <values>
        <field>CheckType__c</field>
        <value xsi:type="xsd:string">SOQLValidation</value>
    </values>
    <values>
        <field>Query__c</field>
        <value xsi:type="xsd:string">SELECT Id, JobType, State, CronExpression FROM CronTrigger WHERE State = 'WAITING' AND JobType = '7'</value>
    </values>
    <values>
        <field>ExpectedResult__c</field>
        <value xsi:type="xsd:string">All expected scheduled Apex jobs are in WAITING state</value>
    </values>
    <values>
        <field>FailureMessage__c</field>
        <value xsi:type="xsd:string">One or more expected scheduled Apex jobs are not running. Reschedule the required jobs in Setup &gt; Scheduled Jobs.</value>
    </values>
    <values>
        <field>ExecutionOrder__c</field>
        <value xsi:type="xsd:double">5</value>
    </values>
    <values>
        <field>Severity__c</field>
        <value xsi:type="xsd:string">Info</value>
    </values>
</CustomMetadata>

<?xml version="1.0" encoding="UTF-8"?>
<!-- Data Classification: Confidential | FLS: Restricted to SmokeTest_Admin | Retention: 1 year | Purge: Database.emptyRecycleBin() -->
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Stores pre/post deployment security health check scores captured via the Tooling API SecurityHealthCheck object. Data Classification: Confidential. Field-level security restricted to SmokeTest_Admin permission set. Retention: 1 year.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>false</enableReports>
    <enableSearch>false</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <label>Security Health Score</label>
    <nameField>
        <displayFormat>SEC-{0000}</displayFormat>
        <label>Security Score Number</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Security Health Scores</pluralLabel>
    <searchLayouts/>
    <sharingModel>Private</sharingModel>
    <visibility>Public</visibility>
</CustomObject>

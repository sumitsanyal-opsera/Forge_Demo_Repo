<?xml version="1.0" encoding="UTF-8"?>
<!-- SmokeTest_Admin — Full access to all smoke test data tiers.
     Data Classification boundary: grants access to both Internal and Confidential tiers.
     SmokeTestAuditLog__c is READ-ONLY at the permission set level. The AuditLog immutability
     trigger (SmokeTestAuditLogTrigger) provides secondary enforcement against edit/delete.
     If new fields are added to any object in future WOs, this permission set must be updated.
     Known Salesforce behavior: users with Modify All Data profile permission can bypass
     object-level security regardless of permission set assignments. -->
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Full access to all smoke test data tiers including Confidential objects (SecurityScore, AuditLog). Grants Publish/Subscribe on all Platform Events. Intended for system administrators and security review personnel only.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>SmokeTest Admin</label>
    <license>Salesforce</license>

    <!-- ================================================================
         Application Visibility
         ================================================================ -->
    <applicationVisibilities>
        <application>SmokeTestCenter</application>
        <visible>true</visible>
    </applicationVisibilities>

    <!-- ================================================================
         Object Permissions — Internal Tier (full CRUD)
         ================================================================ -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>SmokeTestExecution__c</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>SmokeTestResult__c</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <!-- ================================================================
         Object Permissions — Confidential Tier
         SecurityScore: Read/Create only (no Edit/Delete to preserve historical data)
         AuditLog: Read only — trigger enforced immutability on update/delete;
                   system code creates entries via without-sharing context
         ================================================================ -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>SmokeTestSecurityScore__c</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>SmokeTestAuditLog__c</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <!-- ================================================================
         Platform Event Permissions — Publish and Subscribe on all events
         ================================================================ -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>DeploymentComplete__e</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>SmokeTestProgress__e</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>SmokeTestComplete__e</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

